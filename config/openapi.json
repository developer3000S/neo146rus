{
  "openapi": "3.0.0",
  "info": {
    "title": "HTTP API neo146",
    "description": "neo146 предоставляет минимальный HTTP-SMS шлюз, который служит методом экстренного сетевого подключения, вдохновленным dial-up, позволяя получать доступ к контенту через SMS.",
    "version": "1.0.0",
    "contact": {
      "email": "neo146@riseup.net"
    }
  },
  "servers": [
    {
      "url": "https://neo146.net",
      "description": "Продакшн-сервер"
    },
    {
      "url": "http://localhost:8080",
      "description": "Сервер разработки"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Документация сервиса",
        "description": "Возвращает основную документацию о сервисе neo146",
        "responses": {
          "200": {
            "description": "Текст документации",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/uri2md": {
      "get": {
        "summary": "Преобразовать URI в Markdown",
        "description": "Получает содержимое по указанному URI и преобразует его в формат Markdown",
        "parameters": [
          {
            "in": "query",
            "name": "uri",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "URI для получения и преобразования в Markdown"
          },
          {
            "in": "query",
            "name": "b64",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Нужно ли кодировать ответ в base64"
          }
        ],
        "responses": {
          "200": {
            "description": "Содержимое Markdown",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос — отсутствует параметр",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Ошибка сервера",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/twitter": {
      "get": {
        "summary": "Получить твиты пользователя",
        "description": "Получает последние 5 твитов пользователя Twitter",
        "parameters": [
          {
            "in": "query",
            "name": "user",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Имя пользователя Twitter"
          },
          {
            "in": "query",
            "name": "b64",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Нужно ли кодировать ответ в base64"
          }
        ],
        "responses": {
          "200": {
            "description": "Содержимое твитов",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос — отсутствует параметр",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Ошибка сервера",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/ddg": {
      "get": {
        "summary": "Поиск в DuckDuckGo",
        "description": "Поиск в вебе с помощью DuckDuckGo",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Поисковый запрос"
          },
          {
            "in": "query",
            "name": "b64",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Нужно ли кодировать ответ в base64"
          }
        ],
        "responses": {
          "200": {
            "description": "Результаты поиска",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос — отсутствует параметр",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Ошибка сервера",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}